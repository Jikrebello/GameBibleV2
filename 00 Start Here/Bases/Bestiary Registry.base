filters:
  and:
    - 'type == "creature"'
    - '!file.inFolder("90 Archive & Drafts")'
    - '!file.inFolder("99 Templates")'
formulas:
  coverage_count: 'catalogued_forms.length'
properties:
  status:
    displayName: Status
  origin_layer:
    displayName: Origin
  continuity:
    displayName: Continuity
  bearer_continuity:
    displayName: Mantle Bearer
  shell_affinity:
    displayName: Shell Affinity
  animating_principle:
    displayName: Animating Principle
  intelligence:
    displayName: Intelligence
  moral_agency:
    displayName: Moral Agency
  encounter_tier:
    displayName: Threat Tier
  rank:
    displayName: Rank
  creature_family:
    displayName: Family
  catalogued_forms:
    displayName: Catalogued Forms
  formula.coverage_count:
    displayName: Forms
  habitats:
    displayName: Habitats
  encounter_roles:
    displayName: Roles
  appears_in:
    displayName: Adventures
  needs:
    displayName: Needs
views:
  - type: table
    name: Coverage
    groupBy:
      property: note.origin_layer
      direction: ASC
    order:
      - file.name
      - origin_layer
      - creature_family
      - formula.coverage_count
      - catalogued_forms
      - status
    sort:
      - property: origin_layer
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: By Origin
    groupBy:
      property: note.origin_layer
      direction: ASC
    order:
      - file.name
      - origin_layer
      - creature_family
      - continuity
      - bearer_continuity
      - encounter_tier
      - rank
      - needs
    sort:
      - property: origin_layer
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Quest Ready
    filters:
      and:
        - 'status == "canon"'
        - needs.length == 0
    order:
      - file.name
      - creature_family
      - encounter_roles
      - habitats
      - rank
      - appears_in
  - type: table
    name: By Threat Tier
    groupBy:
      property: note.encounter_tier
      direction: ASC
    order:
      - file.name
      - encounter_tier
      - rank
      - encounter_roles
      - continuity
  - type: table
    name: By Intelligence
    groupBy:
      property: note.intelligence
      direction: ASC
    order:
      - file.name
      - intelligence
      - moral_agency
      - continuity
      - creature_family
  - type: table
    name: By Continuity
    groupBy:
      property: note.continuity
      direction: ASC
    order:
      - file.name
      - continuity
      - origin_layer
      - intelligence
      - moral_agency
  - type: table
    name: Adventure Demand
    filters: 'appears_in.length > 0'
    order:
      - file.name
      - appears_in
      - encounter_roles
      - rank
      - needs
  - type: table
    name: Devil Bearers
    filters: 'continuity == "infrastructure-office"'
    order:
      - file.name
      - bearer_continuity
      - creature_family
      - rank
      - related_magic
      - needs
  - type: table
    name: Shell Affinity
    filters: 'origin_layer == "shell"'
    groupBy:
      property: note.shell_affinity
      direction: ASC
    order:
      - file.name
      - shell_affinity
      - creature_family
      - catalogued_forms
      - rank
      - needs
  - type: table
    name: Construct Principle
    filters: 'origin_layer == "crafted"'
    groupBy:
      property: note.animating_principle
      direction: ASC
    order:
      - file.name
      - animating_principle
      - continuity
      - intelligence
      - moral_agency
      - catalogued_forms
      - needs
  - type: table
    name: Unfinished Creature Work
    filters:
      or:
        - 'status != "canon"'
        - needs.length > 0
    order:
      - file.name
      - status
      - origin_layer
      - creature_family
      - needs
    sort:
      - property: origin_layer
        direction: ASC
      - property: file.name
        direction: ASC
