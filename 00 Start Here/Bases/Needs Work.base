filters:
  and:
    - '!file.inFolder("90 Archive & Drafts")'
    - '!file.inFolder("99 Templates")'
    - or:
        - status != "canon"
        - needs.length > 0
properties:
  status:
    displayName: Status
  type:
    displayName: Type
  needs:
    displayName: Needs
  canon_level:
    displayName: Canon Level
views:
  - type: table
    name: Needs Work
    order:
      - file.name
      - status
      - type
      - needs
      - canon_level
      - visibility
    sort:
      - property: status
        direction: DESC
