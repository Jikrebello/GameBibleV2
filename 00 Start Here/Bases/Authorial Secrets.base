filters:
  and:
    - 'status == "canon"'
    - '!file.inFolder("90 Archive & Drafts")'
    - '!file.inFolder("99 Templates")'
    - 'type != "index"'
    - 'type != "reference"'
    - 'type != "quest"'
    - 'type != "mechanic"'
    - or:
        - 'visibility == "secret"'
        - 'visibility == "author-only"'
properties:
  type:
    displayName: Type
  visibility:
    displayName: Visibility
  canon_level:
    displayName: Canon Level
  related_factions:
    displayName: Related Factions
  needs:
    displayName: Needs
views:
  - type: table
    name: Authorial Secrets
    order:
      - file.name
      - visibility
      - type
      - related_factions
      - needs
      - canon_level
