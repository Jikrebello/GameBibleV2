filters:
  and:
    - '!file.inFolder("90 Archive & Drafts")'
    - '!file.inFolder("99 Templates")'
    - or:
        - canon_level == "disputed"
        - canon_level == "apocryphal"
properties:
  type:
    displayName: Type
  status:
    displayName: Status
  canon_level:
    displayName: Canon Level
  culture:
    displayName: Culture
  reliability:
    displayName: Reliability
views:
  - type: table
    name: Apocrypha & In-World Sources
    order:
      - file.name
      - type
      - status
      - canon_level
      - culture
      - reliability
