filters:
  and:
    - '!file.inFolder("90 Archive & Drafts")'
    - '!file.inFolder("99 Templates")'
    - status == "canon"
    - or:
        - appears_in.contains("Grenzburg")
        - appears_in.contains("Caleran")
        - type == "quest"
        - type == "mechanic"
        - type == "place"
properties:
  type:
    displayName: Type
  status:
    displayName: Status
  appears_in:
    displayName: Appears In
  region:
    displayName: Region
  needs:
    displayName: Needs
views:
  - type: table
    name: Game-Ready Content
    order:
      - file.name
      - type
      - status
      - appears_in
      - region
      - needs
