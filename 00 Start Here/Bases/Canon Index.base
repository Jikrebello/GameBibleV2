filters:
  and:
    - status == "canon"
    - '!file.inFolder("90 Archive & Drafts")'
    - '!file.inFolder("99 Templates")'
properties:
  type:
    displayName: Type
  canon_level:
    displayName: Canon Level
  region:
    displayName: Region
  culture:
    displayName: Culture
  appears_in:
    displayName: Appears In
  visibility:
    displayName: Visibility
views:
  - type: table
    name: Canon Index
    order:
      - file.name
      - type
      - canon_level
      - region
      - culture
      - appears_in
      - visibility
    sort:
      - property: file.name
        direction: ASC
      - property: type
        direction: ASC
      - property: appears_in
        direction: DESC
