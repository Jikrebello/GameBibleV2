filters:
  and:
    - '!file.inFolder("90 Archive & Drafts")'
    - '!file.inFolder("99 Templates")'
    - 'appears_in.contains("Grenzburg")'
    - 'companion_id != ""'
properties:
  companion_id:
    displayName: ID
  sex:
    displayName: Sex
  vocation:
    displayName: Vocation
  recruitment_window:
    displayName: Recruitment
  foil:
    displayName: Foil
  relationship_theme:
    displayName: Relationship Theme
  quest_owner:
    displayName: Quest Owner
  quest_sequence:
    displayName: Sequence
  availability_window:
    displayName: Window
  blocking_status:
    displayName: Blocking
  reward_unlocks:
    displayName: Rewards
  architecture_status:
    displayName: Architecture
  companion_content_role:
    displayName: Content Role
  relationship_variant:
    displayName: Relationship Variant
  companion_campaign_stage:
    displayName: Campaign Stage
  preparation_threshold:
    displayName: Preparation
  autonomous_deadline:
    displayName: Deadline
  autonomous_resolution:
    displayName: Autonomous Route
  changed_reentry:
    displayName: Re-entry
  ensemble_inputs:
    displayName: Ensemble Inputs
views:
  - type: table
    name: Companion Roster
    filters: 'type == "character"'
    order:
      - companion_id
      - file.name
      - sex
      - vocation
      - recruitment_window
      - foil
      - relationship_theme
    sort:
      - property: companion_id
        direction: ASC
  - type: table
    name: Existing Quest Sources
    filters: 'quest_class == "companion"'
    groupBy:
      property: note.quest_owner
      direction: ASC
    order:
      - companion_id
      - quest_sequence
      - file.name
      - companion_content_role
      - relationship_variant
      - companion_campaign_stage
      - availability_window
      - architecture_status
      - blocking_status
    sort:
      - property: companion_id
        direction: ASC
      - property: quest_sequence
        direction: ASC
  - type: table
    name: Migrated Campaign Pieces
    filters:
      and:
        - 'quest_class == "companion"'
        - 'architecture_status == "migrated"'
    groupBy:
      property: note.quest_owner
      direction: ASC
    order:
      - companion_id
      - quest_sequence
      - file.name
      - companion_content_role
      - relationship_variant
      - companion_campaign_stage
      - availability_window
      - preparation_threshold
      - reward_unlocks
      - autonomous_deadline
      - changed_reentry
      - blocking_status
    sort:
      - property: companion_id
        direction: ASC
      - property: quest_sequence
        direction: ASC
  - type: table
    name: Architecture Migration
    filters:
      and:
        - 'quest_class == "companion"'
        - 'architecture_status == "pending-migration"'
    groupBy:
      property: note.quest_owner
      direction: ASC
    order:
      - companion_id
      - quest_sequence
      - file.name
      - companion_content_role
      - relationship_variant
      - companion_campaign_stage
      - preparation_threshold
      - autonomous_deadline
      - changed_reentry
    sort:
      - property: companion_id
        direction: ASC
      - property: quest_sequence
        direction: ASC
